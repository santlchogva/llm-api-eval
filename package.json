{
  "name": "llm-api-eval",
  "version": "1.0.0",
  "description": "LLM-API-Eval - 大模型 API 接口压测平台，支持 OpenAI / Anthropic 等主流接口协议的压力测试与性能评估",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest"
  },
  "keywords": [
    "stress-test",
    "openai",
    "anthropic",
    "rpm",
    "api-testing",
    "load-testing",
    "benchmark"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.17.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "fast-check": "^4.4.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.1"
  },
  "jest": {
    "testMatch": [
      "**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "src/routes/test.js"
    ]
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
